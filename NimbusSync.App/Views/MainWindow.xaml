<Window x:Class="NimbusSync.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:NimbusSync.App.ViewModels"
        xmlns:svc="clr-namespace:NimbusSync.App.Services"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="NimbusSync"
        Width="1060" Height="700" MinWidth="800" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Style="{DynamicResource {x:Type Window}}">

    <Window.Resources>

        <!-- ======================================================== folder card -->
        <DataTemplate x:Key="ProfileCard" DataType="{x:Type vm:ProfileViewModel}">
            <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Width="40" Height="40" VerticalAlignment="Center">
                        <Border CornerRadius="8" Background="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8B7;" FontSize="20"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        <Ellipse Style="{StaticResource StatusDot}" Tag="{Binding Kind}" Width="14" Height="14"
                                 HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-3,-3"
                                 Stroke="{DynamicResource CardBackgroundFillColorDefaultBrush}" StrokeThickness="2" />
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyStrong}" Text="{Binding Name}" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                   Text="{Binding LocalRootPath}" ToolTip="{Binding LocalRootPath}" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0">
                            <Run Text="{Binding RemoteSummary, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding DirectionText, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,16,0" MinWidth="150" MaxWidth="260" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusText}" FontSize="13" TextAlignment="Right" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Style="{StaticResource Caption}" TextAlignment="Right" Margin="0,2,0,0"
                                   Visibility="{Binding LastSyncedAt, Converter={StaticResource NullToVisibility}}">
                            <Run Text="Synced " /><Run Text="{Binding LastSyncedAt, Converter={StaticResource RelativeTime}, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Caption}" TextAlignment="Right" Margin="0,2,0,0"
                                   Text="{Binding ErrorMessage}" ToolTip="{Binding ErrorMessage}"
                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                   Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}" />
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButton}" Content="&#xE895;" Command="{Binding SyncNowCommand}"
                                ToolTip="Sync now" AutomationProperties.Name="Sync now" />
                        <Button Style="{StaticResource IconButton}" Content="{Binding ToggleRunGlyph}" Command="{Binding ToggleRunCommand}"
                                ToolTip="{Binding ToggleRunLabel}" AutomationProperties.Name="{Binding ToggleRunLabel}" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE712;" Click="MoreButton_Click"
                                ToolTip="More options" AutomationProperties.Name="More options">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Open folder" Command="{Binding OpenFolderCommand}">
                                        <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE838;" /></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Edit…" Command="{Binding EditCommand}">
                                        <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE70F;" /></MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="Stop syncing this folder…" Command="{Binding RemoveCommand}">
                                        <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" /></MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ======================================================== conflict card -->
        <DataTemplate x:Key="ConflictCard" DataType="{x:Type vm:ConflictViewModel}">
            <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE8DA;"
                                Command="{Binding RevealCommand}" ToolTip="Show on this PC" AutomationProperties.Name="Show on this PC" />
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE7BA;" FontSize="20" Margin="0,2,14,0" VerticalAlignment="Top"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource BodyStrong}" Text="{Binding FileName}" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0">
                                <Run Text="{Binding Location, Mode=OneWay}" /><Run Text=" · detected " /><Run Text="{Binding DetectedAt, Converter={StaticResource RelativeTime}, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>

                    <Grid Margin="34,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border CornerRadius="6" Padding="12,10" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE7F8;" FontSize="14" />
                                    <TextBlock Text="This PC" FontWeight="SemiBold" Margin="8,0,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0">
                                    <Run Text="{Binding LocalSize, Converter={StaticResource ByteSize}, Mode=OneWay}" /><Run Text=" · modified " /><Run Text="{Binding LocalModifiedText, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" CornerRadius="6" Padding="12,10" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE753;" FontSize="14" />
                                    <TextBlock Text="Google Drive" FontWeight="SemiBold" Margin="8,0,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0">
                                    <Run Text="{Binding RemoteSize, Converter={StaticResource ByteSize}, Mode=OneWay}" /><Run Text=" · modified " /><Run Text="{Binding RemoteModifiedText, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <WrapPanel Margin="34,14,0,0" VerticalAlignment="Center">
                        <Button Content="Keep this PC's version" Command="{Binding KeepLocalCommand}" Margin="0,0,8,6"
                                ToolTip="Upload this PC's file over the Drive version" />
                        <Button Content="Keep Drive's version" Command="{Binding KeepRemoteCommand}" Margin="0,0,8,6"
                                ToolTip="Download the Drive file over this PC's version" />
                        <Button Content="Keep both" Command="{Binding KeepBothCommand}" Margin="0,0,8,6"
                                Style="{DynamicResource AccentButtonStyle}"
                                ToolTip="Rename this PC's copy, upload it, and download the Drive version alongside it" />
                        <ProgressBar IsIndeterminate="True" Width="80" Margin="8,0,0,6" VerticalAlignment="Center"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Caption}" Margin="34,2,0,0"
                               Visibility="{Binding CanResolve, Converter={StaticResource InverseBoolToVisibility}}">
                        <Run Text="Resume “" /><Run Text="{Binding Profile.Name, Mode=OneWay}" /><Run Text="” to resolve this conflict." />
                    </TextBlock>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- ======================================================== activity row -->
        <DataTemplate x:Key="ActivityRow" DataType="{x:Type vm:ActivityEntry}">
            <Grid Margin="16,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="84" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Glyph}" FontSize="14" HorizontalAlignment="Left">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:ActivityKind.Success}">
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:ActivityKind.Warning}">
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:ActivityKind.Error}">
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Grid.Column="1" Style="{StaticResource Caption}" Text="{Binding TimeText}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Style="{StaticResource Caption}" Text="{Binding Source}" Margin="0,0,12,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="{Binding Message}" ToolTip="{Binding Message}" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </Grid>
        </DataTemplate>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============================================================ navigation -->
        <DockPanel Margin="12,16,12,12">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,4,0,24">
                <Path Data="{x:Static svc:AppIcon.CloudGeometry}" Fill="{DynamicResource AccentFillColorDefaultBrush}"
                      Width="26" Height="26" Stretch="Uniform" />
                <TextBlock Text="NimbusSync" FontSize="17" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </StackPanel>

            <Border DockPanel.Dock="Bottom" CornerRadius="6" Padding="14,10" Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                    ToolTip="Overall sync status">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Style="{StaticResource StatusDot}" Tag="{Binding OverallKind}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding OverallText}" Margin="10,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </StackPanel>
            </Border>

            <StackPanel>
                <RadioButton Style="{StaticResource NavItem}" AutomationProperties.Name="Sync folders"
                             IsChecked="{Binding SelectedPage, Converter={StaticResource EnumEquals}, ConverterParameter=Folders}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8B7;" />
                        <TextBlock Text="Sync folders" Margin="14,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource NavItem}" AutomationProperties.Name="Conflicts"
                             IsChecked="{Binding SelectedPage, Converter={StaticResource EnumEquals}, ConverterParameter=Conflicts}"
                             HorizontalContentAlignment="Stretch">
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Style="{StaticResource Badge}"
                                Visibility="{Binding ConflictCount, Converter={StaticResource CountToVisibility}}">
                            <TextBlock Text="{Binding ConflictCount}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Foreground="Black" />
                        </Border>
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE7BA;" />
                        <TextBlock Text="Conflicts" Margin="14,0,0,0" VerticalAlignment="Center" />
                    </DockPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource NavItem}" AutomationProperties.Name="Activity"
                             IsChecked="{Binding SelectedPage, Converter={StaticResource EnumEquals}, ConverterParameter=Activity}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE81C;" />
                        <TextBlock Text="Activity" Margin="14,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource NavItem}" AutomationProperties.Name="Settings"
                             IsChecked="{Binding SelectedPage, Converter={StaticResource EnumEquals}, ConverterParameter=Settings}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE713;" />
                        <TextBlock Text="Settings" Margin="14,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </DockPanel>

        <!-- ============================================================ content -->
        <Border Grid.Column="1" CornerRadius="8,0,0,0" BorderThickness="1,1,0,0"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid>

                <!-- ──────────────────────────────────────────────── folders -->
                <Grid Visibility="{Binding SelectedPage, Converter={StaticResource EnumToVisibility}, ConverterParameter=Folders}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Margin="32,28,32,20">
                        <Button DockPanel.Dock="Right" Style="{DynamicResource AccentButtonStyle}" Command="{Binding AddProfileCommand}"
                                VerticalAlignment="Center" Padding="14,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" FontSize="12" />
                                <TextBlock Text="Add folder" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <TextBlock Style="{StaticResource PageTitle}" Text="Sync folders" />
                    </DockPanel>

                    <Border Grid.Row="1" Style="{StaticResource InfoBar}" Margin="32,0,32,16"
                            Visibility="{Binding IsSignedIn, Converter={StaticResource InverseBoolToVisibility}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Connect" Command="{Binding SignInCommand}" VerticalAlignment="Center"
                                    Style="{DynamicResource AccentButtonStyle}" Padding="16,6" />
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE946;" Margin="0,0,14,0" VerticalAlignment="Top"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Style="{StaticResource BodyStrong}" Text="Google Drive isn't connected" />
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,2,0,0"
                                           Text="Syncing starts as soon as you connect your Google account." />
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,4,0,0"
                                           Text="{Binding AccountMessage}"
                                           Visibility="{Binding AccountMessage, Converter={StaticResource NullToVisibility}}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="32,0,32,24">
                        <Grid>
                            <ItemsControl ItemsSource="{Binding Profiles}" ItemTemplate="{StaticResource ProfileCard}" Focusable="False" />

                            <StackPanel HorizontalAlignment="Center" Margin="0,56,0,0" MaxWidth="400"
                                        Visibility="{Binding Profiles.Count, Converter={StaticResource ZeroToVisibility}}">
                                <Path Data="{x:Static svc:AppIcon.CloudGeometry}" Fill="{DynamicResource SubtleFillColorSecondaryBrush}"
                                      Width="72" Height="72" Stretch="Uniform" HorizontalAlignment="Center" />
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Nothing is syncing yet" HorizontalAlignment="Center" Margin="0,16,0,6" />
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" TextAlignment="Center"
                                           Text="Pair a folder on this PC with a folder in Google Drive or a shared drive. Changes on either side flow to the other, and nothing is ever permanently deleted." />
                                <Button Content="Add your first folder" Command="{Binding AddProfileCommand}" HorizontalAlignment="Center"
                                        Margin="0,20,0,0" Padding="16,6" Style="{DynamicResource AccentButtonStyle}" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <!-- ──────────────────────────────────────────────── conflicts -->
                <Grid Visibility="{Binding SelectedPage, Converter={StaticResource EnumToVisibility}, ConverterParameter=Conflicts}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="32,28,32,20">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Conflicts" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,6,0,0" MaxWidth="640"
                                   HorizontalAlignment="Left"
                                   Text="These files changed on this PC and in Google Drive since they last matched. Each one is on hold in both directions until you pick the version to keep." />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="32,0,32,24">
                        <Grid>
                            <ItemsControl ItemsSource="{Binding Conflicts}" ItemTemplate="{StaticResource ConflictCard}" Focusable="False" />

                            <StackPanel HorizontalAlignment="Center" Margin="0,56,0,0" MaxWidth="380"
                                        Visibility="{Binding Conflicts.Count, Converter={StaticResource ZeroToVisibility}}">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE73E;" FontSize="44"
                                           Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                                <TextBlock Style="{StaticResource SectionTitle}" Text="No conflicts" HorizontalAlignment="Center" Margin="0,16,0,6" />
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" TextAlignment="Center"
                                           Text="This PC and Google Drive agree on every synced file." />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <!-- ──────────────────────────────────────────────── activity -->
                <Grid Visibility="{Binding SelectedPage, Converter={StaticResource EnumToVisibility}, ConverterParameter=Activity}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Margin="32,28,32,20">
                        <Button DockPanel.Dock="Right" Content="Clear" Command="{Binding ClearActivityCommand}" VerticalAlignment="Center"
                                Visibility="{Binding Activity.Count, Converter={StaticResource CountToVisibility}}" />
                        <TextBlock Style="{StaticResource PageTitle}" Text="Activity" />
                    </DockPanel>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="32,0,32,24" Padding="0,6">
                        <Grid>
                            <ItemsControl ItemsSource="{Binding Activity}" ItemTemplate="{StaticResource ActivityRow}"
                                          VirtualizingPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True" Focusable="False">
                                <ItemsControl.Template>
                                    <ControlTemplate TargetType="ItemsControl">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="True" Focusable="False">
                                            <ItemsPresenter />
                                        </ScrollViewer>
                                    </ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <TextBlock Style="{StaticResource Caption}" Text="Uploads, downloads, conflicts, and errors appear here."
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding Activity.Count, Converter={StaticResource ZeroToVisibility}}" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- ──────────────────────────────────────────────── settings -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding SelectedPage, Converter={StaticResource EnumToVisibility}, ConverterParameter=Settings}">
                    <StackPanel Margin="32,28,32,32" MaxWidth="720" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Settings" Margin="0,0,0,20" />

                        <!-- account -->
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Google account" />
                        <Border Style="{StaticResource Card}" Margin="0,0,0,24">
                            <StackPanel>
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Connect" Command="{Binding SignInCommand}" Style="{DynamicResource AccentButtonStyle}"
                                                Padding="16,6"
                                                Visibility="{Binding IsSignedIn, Converter={StaticResource InverseBoolToVisibility}}" />
                                        <Button Content="Disconnect" Command="{Binding SignOutCommand}" Padding="16,6"
                                                Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE77B;" FontSize="20" Margin="0,0,14,0" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource BodyStrong}" Text="Connected to Google Drive"
                                                   Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Style="{StaticResource BodyStrong}" Text="Not connected"
                                                   Visibility="{Binding IsSignedIn, Converter={StaticResource InverseBoolToVisibility}}" />
                                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,2,0,0"
                                                   Text="Connecting opens your browser to approve access. NimbusSync keeps a refresh token on this PC." />
                                    </StackPanel>
                                </DockPanel>
                                <ProgressBar IsIndeterminate="True" Margin="34,12,0,0"
                                             Visibility="{Binding IsSigningIn, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="34,8,0,0"
                                           Text="{Binding AccountMessage}"
                                           Visibility="{Binding AccountMessage, Converter={StaticResource NullToVisibility}}" />
                            </StackPanel>
                        </Border>

                        <!-- oauth client -->
                        <TextBlock Style="{StaticResource SectionTitle}" Text="OAuth client" />
                        <Border Style="{StaticResource Card}" Margin="0,0,0,24">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,0,0,16"
                                           Text="NimbusSync signs in with your own Google Cloud OAuth client: create a Desktop app client in a project with the Drive API enabled. The secret is encrypted for your Windows account." />
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Client ID" />
                                <TextBox Text="{Binding ClientId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"
                                         AutomationProperties.Name="Client ID" />
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Client secret" />
                                <PasswordBox x:Name="SecretBox" PasswordChanged="SecretBox_PasswordChanged" AutomationProperties.Name="Client secret" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" Text="A secret is saved. Type a new one to replace it."
                                           Visibility="{Binding HasSavedSecret, Converter={StaticResource BoolToVisibility}}" />
                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                    <Button Content="Save" Command="{Binding SaveSettingsCommand}" Style="{DynamicResource AccentButtonStyle}" Padding="20,6" />
                                    <TextBlock Style="{StaticResource Caption}" Text="{Binding SettingsMessage}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- app -->
                        <TextBlock Style="{StaticResource SectionTitle}" Text="App" />
                        <Border Style="{StaticResource Card}" Margin="0,0,0,24">
                            <StackPanel>
                                <CheckBox IsChecked="{Binding StartMinimized}">
                                    <StackPanel>
                                        <TextBlock Text="Start in the notification area" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Style="{StaticResource Caption}" Text="Skip opening this window when an account is set up." />
                                    </StackPanel>
                                </CheckBox>
                                <Separator Margin="0,14" />
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Open data folder" Command="{Binding OpenDataFolderCommand}" Margin="0,0,8,0" />
                                        <Button Content="Open logs" Command="{Binding OpenLogsCommand}" />
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Data folder" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Style="{StaticResource Caption}" Text="{Binding DataDirectory}" ToolTip="{Binding DataDirectory}" />
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource Caption}">
                            <Run Text="NimbusSync " /><Run Text="{Binding AppVersion, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>

            </Grid>
        </Border>
    </Grid>
</Window>
