<Window x:Class="NimbusSync.App.Views.ProfileEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:NimbusSync.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:ProfileEditorViewModel}"
        Title="{Binding Title}"
        Width="600" Height="720" MinWidth="480" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResize"
        Style="{DynamicResource {x:Type Window}}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,24,28,16">
                <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,20"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                <TextBlock Style="{StaticResource FieldLabel}" Text="Name" />
                <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,18"
                         AutomationProperties.Name="Name" />

                <TextBlock Style="{StaticResource FieldLabel}" Text="Folder on this PC" />
                <DockPanel Margin="0,0,0,4">
                    <Button DockPanel.Dock="Right" Content="Browse…" Margin="8,0,0,0" Click="Browse_Click"
                            IsEnabled="{Binding IsNew}" />
                    <TextBox Text="{Binding LocalRootPath, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsExisting}"
                             AutomationProperties.Name="Folder on this PC" />
                </DockPanel>
                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,0,0,18"
                           Text="Files already in this folder are uploaded; files in the Drive folder are downloaded into it." />

                <TextBlock Style="{StaticResource FieldLabel}" Text="Google Drive folder" />
                <TextBox Text="{Binding RemoteInput, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsExisting}"
                         Margin="0,0,0,4" AutomationProperties.Name="Google Drive folder" />
                <TextBlock Style="{StaticResource Caption}" Text="{Binding RemoteHint}" Margin="0,0,0,18" />

                <TextBlock Style="{StaticResource FieldLabel}" Text="Shared drive (optional)" />
                <TextBox Text="{Binding SharedDriveInput, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsExisting}"
                         Margin="0,0,0,4" AutomationProperties.Name="Shared drive" />
                <TextBlock Style="{StaticResource Caption}" Text="{Binding SharedDriveHint}" Margin="0,0,0,8" />

                <Border Style="{StaticResource InfoBar}" Margin="0,4,0,18"
                        Visibility="{Binding IsNew, Converter={StaticResource InverseBoolToVisibility}}">
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None"
                               Text="The local folder and Drive locations can't change after a folder is added. To sync somewhere else, add a new folder and remove this one." />
                </Border>

                <TextBlock Style="{StaticResource SectionTitle}" Text="Direction" Margin="0,8,0,10" />
                <RadioButton GroupName="Direction" Margin="0,0,0,10"
                             IsChecked="{Binding Direction, Converter={StaticResource EnumEquals}, ConverterParameter=Bidirectional}">
                    <StackPanel>
                        <TextBlock Text="Two-way" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Style="{StaticResource Caption}" Text="Changes on either side are copied to the other." />
                    </StackPanel>
                </RadioButton>
                <RadioButton GroupName="Direction" Margin="0,0,0,10"
                             IsChecked="{Binding Direction, Converter={StaticResource EnumEquals}, ConverterParameter=LocalToRemote}">
                    <StackPanel>
                        <TextBlock Text="Upload only" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Style="{StaticResource Caption}" Text="This PC is the source; Drive mirrors it." />
                    </StackPanel>
                </RadioButton>
                <RadioButton GroupName="Direction" Margin="0,0,0,18"
                             IsChecked="{Binding Direction, Converter={StaticResource EnumEquals}, ConverterParameter=RemoteToLocal}">
                    <StackPanel>
                        <TextBlock Text="Download only" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Style="{StaticResource Caption}" Text="Drive is the source; this PC mirrors it." />
                    </StackPanel>
                </RadioButton>

                <TextBlock Style="{StaticResource SectionTitle}" Text="Options" Margin="0,8,0,10" />
                <TextBlock Style="{StaticResource FieldLabel}" Text="Check Google Drive for changes" />
                <ComboBox ItemsSource="{Binding PollOptions}" DisplayMemberPath="Label" SelectedValuePath="Seconds"
                          SelectedValue="{Binding PollIntervalSeconds}" Margin="0,0,0,18" MinWidth="220" HorizontalAlignment="Left"
                          AutomationProperties.Name="Check Google Drive for changes" />

                <TextBlock Style="{StaticResource FieldLabel}" Text="Google Docs, Sheets, and Slides" />
                <RadioButton GroupName="Native" Margin="0,0,0,8"
                             IsChecked="{Binding NativeFilePolicy, Converter={StaticResource EnumEquals}, ConverterParameter=LinkStub}">
                    <StackPanel>
                        <TextBlock Text="Add shortcuts that open them in the browser" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Style="{StaticResource Caption}" Text="Edits to the shortcut files are never uploaded." />
                    </StackPanel>
                </RadioButton>
                <RadioButton GroupName="Native" Margin="0,0,0,18"
                             IsChecked="{Binding NativeFilePolicy, Converter={StaticResource EnumEquals}, ConverterParameter=Skip}">
                    <TextBlock Text="Leave them out" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </RadioButton>

                <TextBlock Style="{StaticResource FieldLabel}" Text="Don't sync files matching" />
                <TextBox Text="{Binding ExcludePatterns, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                         TextWrapping="NoWrap" MinHeight="110" MaxHeight="180" VerticalScrollBarVisibility="Auto"
                         FontFamily="Cascadia Mono, Consolas" AutomationProperties.Name="Exclusion patterns" />
                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,4,0,0"
                           Text="One pattern per line, matched against each file and folder name and the full path. * and ? are wildcards." />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Padding="28,16" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource LayerFillColorDefaultBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="{Binding SaveLabel}" Command="{Binding SaveCommand}" IsDefault="True" MinWidth="110"
                            Style="{DynamicResource AccentButtonStyle}" />
                    <Button Content="Cancel" IsCancel="True" MinWidth="90" Margin="8,0,0,0" />
                </StackPanel>
                <TextBlock Text="{Binding Error}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0"
                           Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
